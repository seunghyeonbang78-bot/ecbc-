{
  "name": "ecbc",
  "main": "worker.js",
  "compatibility_date": "2026-10-20",
  "keep_vars": true,
  "build": {
    "command": "node scripts/build-assets.mjs"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/oauth/*"
    ]
  },
  "vars": {
    "SITE_URL": "https://ecbc.ecbc-seunghyeon.workers.dev/"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ecbc-db",
      "database_id": "8e0c2826-d881-41b0-805a-95a2edf8ac0f"
    }
  ]
}
