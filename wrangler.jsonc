{
  "name": "ecbc",
  "main": "worker.js",
  "compatibility_date": "2026-10-20",
  "keep_vars": true,
  "build": {
    "command": "node scripts/build-assets.mjs"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/oauth/*"
    ]
  }
}
